# comercial.dualab.es solo sirve archivos estáticos (dist-comercial/); la API está en api.dualab.es.

# Rutas de la SPA (/entrevista/12, /mi-usuario…) → index.html; el router de Vue hace el resto
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>

AddType application/manifest+json .webmanifest

# Lo que no lleva hash en el nombre se pide siempre al servidor: si se quedara en la caché
# HTTP, la tablet no vería el service worker ni el index.html del último deploy.
# (/assets lleva su propio .htaccess con caché de un año: esos nombres sí llevan hash.)
<IfModule mod_headers.c>
    # App interna del equipo comercial: fuera de buscadores y sin marcos (como Nexo y Central).
    # Sin cámara, micrófono ni ubicación: la firma se dibuja en un canvas.
    Header set X-Robots-Tag "noindex, nofollow"
    Header set X-Frame-Options "DENY"
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Strict-Transport-Security "max-age=31536000"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"

    <FilesMatch "^(index\.html|sw\.js|registerSW\.js|version\.json|manifest\.webmanifest|favicon\.(ico|png)|apple-touch-icon\.png|pwa-\d+x\d+\.png|maskable-icon-\d+x\d+\.png)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
