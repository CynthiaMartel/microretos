# =============================================
# PUERTOS - Cambia según tu setup local
# =============================================
APP_PORT=8000
VITE_PORT=5173
VITE_API_URL=https://api.dualab.es/api

# =============================================
# APP
# =============================================
APP_NAME=Laravel
APP_ENV=local
APP_KEY=                    # Genera con: php artisan key:generate
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# =============================================
# LOGS
# =============================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =============================================
# BASE DE DATOS
# =============================================
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=microretos
DB_USERNAME=sail
DB_PASSWORD=password
FORWARD_DB_PORT=3307

# =============================================
# SESIÓN / CACHÉ / COLAS
# =============================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Sanctum SPA stateful: dominios del frontend cuyas requests se tratan como
# "de confianza" (cookie de sesión + CSRF) en vez de exigir Bearer token.
# En producción: dominio real del frontend (dualab.es), NUNCA el de la API.
# Producción necesita además SESSION_SECURE_COOKIE=true (HTTPS) — no puesto aquí
# porque este .env.example es la base de desarrollo local (HTTP).
# URL pública de la SPA (enlaces de email, p. ej. restablecer contraseña). En producción: https://dualab.es
FRONTEND_URL=http://localhost:5173
# Duración de "Recordarme" en el login, en minutos (10080 = 7 días)
AUTH_REMEMBER_MINUTES=10080
# 5177: app comercial (npm run dev:comercial); 5179: DuaLab Central (npm run dev:central).
# En producción, añadir comercial.dualab.es y central.dualab.es a los dos y
# SESSION_DOMAIN=.dualab.es para compartir la sesión. El Nexo (5178) no usa la API.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:5177,127.0.0.1:5177,localhost:5179,127.0.0.1:5179
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5177,http://localhost:5179
# Textos legales de la entrevista (config/captacion.php): true solo cuando los haya revisado
# el DPO. Mientras sea false, en producción no se pueden recoger firmas.
CAPTACION_TEXTOS_REVISADOS=false
# URL de la app comercial para el enlace del formulario que se envía a la empresa
# (por defecto http://localhost:5177 en local y https://comercial.dualab.es en producción)
COMERCIAL_URL=http://localhost:5177
# Secreto compartido con el webhook del frontoffice (Gestión web → Integraciones), mínimo 16 caracteres
FRONTOFFICE_WEBHOOK_SECRETO=
# DuaLab Central → «Primer contacto»: API firmada de la bandeja de formularios de la web.
# En local (Sail): http://host.docker.internal:8001 · en producción: https://info.dualab.es/api-backend/public
FRONTOFFICE_API_URL=
# Mismo valor que CENTRAL_API_SECRETO en el .env de la web (mínimo 32 caracteres)
FRONTOFFICE_CENTRAL_SECRETO=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# =============================================
# REDIS
# =============================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =============================================
# MAIL
# =============================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Buzón de soporte (mailer 'soporte' en config/mail.php): formulario "Contacta con soporte".
# Host/puerto/esquema heredan de MAIL_* si no se indican.
MAIL_SOPORTE_ADDRESS=soporte@dualab.es
MAIL_SOPORTE_NAME="Soporte DUALAB"
MAIL_SOPORTE_USERNAME=soporte@dualab.es
MAIL_SOPORTE_PASSWORD=

# =============================================
# AWS
# =============================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# =============================================
# VITE
# =============================================
VITE_APP_NAME="${APP_NAME}"

# =============================================
# SERVICIOS EXTERNOS - Pide las claves al equipo
# =============================================
OPENAI_API_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Opcionales: cuentas de prueba docente@dualab.es / empresa@dualab.com del seeder (solo local)
SEED_DOCENTE_PASSWORD=
SEED_EMPRESA_PASSWORD=
